# Copy to .env and fill in. Never commit .env.

# Your Perfecto cloud name: the part before .perfectomobile.com
PERFECTO_CLOUD=your-cloud
# Perfecto security token (Perfecto UI > your user menu > Security Token)
PERFECTO_SECURITY_TOKEN=

# Optional: the browser/OS to run on (defaults shown)
PERFECTO_PLATFORM_NAME=Windows
PERFECTO_PLATFORM_VERSION=11
PERFECTO_BROWSER_NAME=Chrome
PERFECTO_BROWSER_VERSION=latest

# Optional: grouping in Perfecto's report
PERFECTO_JOB_NAME=perfecto-connection
PERFECTO_JOB_NUMBER=1

# Optional: Perfecto Connect tunnel ID, only needed to test sites the
# Perfecto cloud can't reach (internal/staging/localhost). Leave empty
# for public sites. Get it by running:
#   ./perfectoconnect start -c mlb.perfectomobile.com -s <security token>
PERFECTO_TUNNEL_ID=
